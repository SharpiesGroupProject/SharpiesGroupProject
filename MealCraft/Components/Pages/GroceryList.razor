@page "/grocery-list"
@using MealCraft.Data
@using MealCraft.Models
@using Microsoft.Data.Sqlite
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MealCraftDbContext> DbContextFactory
@inject ILogger<GroceryList> Logger
@using System.Globalization
@using System.Linq

<PageTitle>Grocery List - MealCraft</PageTitle>

<div class="grocery-page">
    <div class="grocery-heading">
        <div>
            <p class="grocery-eyebrow">MEALCRAFT <span>/</span> SHOPPING</p>
            <h1>Grocery list</h1>
            <p class="grocery-subtitle">A little planning makes every grocery run easier.</p>
        </div>
        <div class="list-date">
            <span class="date-label">YOUR LIST</span>
            <strong>This week</strong>
        </div>
    </div>

    <section class="grocery-summary" aria-label="Grocery list summary">
        <div class="summary-card">
            <span class="summary-icon summary-icon-blue" aria-hidden="true">✓</span>
            <div><strong>@RemainingCount</strong><span>left to get</span></div>
        </div>
        <div class="summary-card">
            <span class="summary-icon summary-icon-amber" aria-hidden="true">✓</span>
            <div><strong>@PurchasedCount</strong><span>in your basket</span></div>
        </div>
        <div class="summary-card summary-card-total">
            <span class="summary-icon summary-icon-neutral" aria-hidden="true">≡</span>
            <div><strong>@items.Count</strong><span>items on your list</span></div>
        </div>
    </section>

    <section class="add-item-panel" aria-labelledby="add-item-heading">
        <div class="panel-heading">
            <div>
                <p class="section-kicker">MAKE IT YOURS</p>
                <h2 id="add-item-heading">Add an item</h2>
            </div>
            <span class="add-item-mark" aria-hidden="true">+</span>
        </div>

        <form class="item-form" @onsubmit="SaveItem" @onsubmit:preventDefault>
            <div class="form-field item-name-field">
                <label for="item-name">Item name <span aria-hidden="true">*</span></label>
                <input id="item-name" type="text" @bind="itemName" maxlength="80"
                       placeholder="e.g. Ripe avocados" autocomplete="off" />
            </div>
            <div class="form-field quantity-field">
                <label for="item-quantity">Quantity <span class="optional-label">optional</span></label>
                <input id="item-quantity" type="text" @bind="itemQuantity" maxlength="40"
                       placeholder="e.g. 3 or 500 g" />
            </div>
            <div class="form-field category-field">
                <label for="item-category">Category</label>
                <select id="item-category" @bind="itemCategory">
                    @foreach (var category in Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="primary-button" type="submit">Add to list</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <p class="form-feedback @(isValidationError ? "feedback-error" : "feedback-success")"
               role="@(isValidationError ? "alert" : "status")" aria-live="polite">@feedbackMessage</p>
        }
    </section>

    <section class="list-panel" aria-labelledby="list-heading">
        <div class="list-toolbar">
            <div>
                <p class="section-kicker">READY WHEN YOU ARE</p>
                <h2 id="list-heading">Your items <span class="item-count">@items.Count</span></h2>
            </div>
            <button type="button" class="clear-button" @onclick="ClearPurchased" disabled="@(PurchasedCount == 0)">
                Clear purchased
            </button>
        </div>

        <div class="list-filters" role="group" aria-label="Filter grocery items">
            <button type="button" class="filter-button @(selectedFilter == "all" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "all")" @onclick="@(() => SetFilter("all"))">
                All <span>@items.Count</span>
            </button>
            <button type="button" class="filter-button @(selectedFilter == "to-buy" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "to-buy")" @onclick="@(() => SetFilter("to-buy"))">
                To buy <span>@RemainingCount</span>
            </button>
            <button type="button" class="filter-button @(selectedFilter == "purchased" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "purchased")" @onclick="@(() => SetFilter("purchased"))">
                Purchased <span>@PurchasedCount</span>
            </button>
        </div>

        @if (!VisibleItems.Any())
        {
            <div class="empty-list">
                <span class="empty-list-icon" aria-hidden="true">✓</span>
                <h3>@(items.Count == 0 ? "Your list is clear" : "Nothing in this view")</h3>
                <p>@(items.Count == 0 ? "Add an item above to get your shopping started." : "Try another filter to see your grocery items.")</p>
            </div>
        }
        else
        {
            <ul class="grocery-items">
                @foreach (var item in VisibleItems)
                {
                    <li class="grocery-item @(item.IsPurchased ? "is-purchased" : "")" @key="item.Id">
                        <label class="purchase-toggle">
                            <input type="checkbox" checked="@item.IsPurchased"
                                   aria-label="Mark @item.Name @(item.IsPurchased ? "as not purchased" : "as purchased")"
                                   @onchange="args => TogglePurchased(item.Id, args.Value is bool isPurchased && isPurchased)" />
                            <span class="custom-checkbox" aria-hidden="true"></span>
                        </label>
                        <div class="item-copy">
                            <strong>@item.Name</strong>
                            <div class="item-details">
                                @if (!string.IsNullOrWhiteSpace(item.Quantity))
                                {
                                    <span>@item.Quantity</span>
                                }
                                <span class="category-tag">@item.Category</span>
                            </div>
                        </div>
                        <div class="item-actions">
                            <button type="button" class="icon-button" aria-label="Edit @item.Name"
                                    title="Edit item" @onclick="@(() => BeginEdit(item))">
                                Edit
                            </button>
                            <button type="button" class="icon-button delete-button" aria-label="Delete @item.Name"
                                    title="Delete item" @onclick="@(() => DeleteItem(item.Id))">
                                Delete
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
        <p class="list-note">Your grocery list and purchased status are saved between visits.</p>
    </section>
</div>

@if (editingItemId is not null)
{
    <div class="edit-modal-backdrop">
        <section class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-item-heading"
                 tabindex="-1" @onkeydown="HandleEditModalKeydown">
            <div class="panel-heading edit-modal-heading">
                <div>
                    <p class="section-kicker">UPDATE YOUR LIST</p>
                    <h2 id="edit-item-heading">Edit item</h2>
                </div>
                <button class="icon-button edit-modal-close" type="button" aria-label="Close edit dialog"
                        @onclick="CancelEdit">×</button>
            </div>

            <form class="edit-item-form" @onsubmit="SaveItem" @onsubmit:preventDefault>
                <div class="form-field">
                    <label for="edit-item-name">Item name <span aria-hidden="true">*</span></label>
                    <input id="edit-item-name" type="text" @bind="itemName" maxlength="80"
                           autocomplete="off" autofocus />
                </div>
                <div class="form-field">
                    <label for="edit-item-quantity">Quantity <span class="optional-label">optional</span></label>
                    <input id="edit-item-quantity" type="text" @bind="itemQuantity" maxlength="40" />
                </div>
                <div class="form-field">
                    <label for="edit-item-category">Category</label>
                    <select id="edit-item-category" @bind="itemCategory">
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                @if (isValidationError && !string.IsNullOrEmpty(feedbackMessage))
                {
                    <p class="form-feedback feedback-error" role="alert">@feedbackMessage</p>
                }

                <div class="edit-modal-actions">
                    <button class="text-button" type="button" @onclick="CancelEdit">Cancel</button>
                    <button class="primary-button" type="submit">Save changes</button>
                </div>
            </form>
        </section>
    </div>
}

@code {
    private static readonly string[] Categories = ["Produce", "Dairy", "Bakery", "Pantry", "Meat & seafood", "Household", "Other"];

    private List<StandaloneGroceryItem> items = [];

    private string itemName = "";
    private string itemQuantity = "";
    private string itemCategory = Categories[0];
    private string selectedFilter = "all";
    private string feedbackMessage = "";
    private bool isValidationError;
    private int? editingItemId;

    private int RemainingCount => items.Count(item => !item.IsPurchased);
    private int PurchasedCount => items.Count(item => item.IsPurchased);

    private IEnumerable<StandaloneGroceryItem> VisibleItems => items
        .Where(item => selectedFilter switch
        {
            "to-buy" => !item.IsPurchased,
            "purchased" => item.IsPurchased,
            _ => true
        })
        .OrderBy(item => item.IsPurchased)
        .ThenBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();
    }

    private async Task<bool> LoadItemsAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            items = await dbContext.StandaloneGroceryItems
                .AsNoTracking()
                .ToListAsync();
            return true;
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to load standalone grocery items.");
            feedbackMessage = "Unable to load your grocery list. Please try again.";
            isValidationError = true;
            return false;
        }
    }

    private async Task SaveItem()
    {
        var trimmedName = itemName.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            feedbackMessage = "Enter an item name before saving.";
            isValidationError = true;
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            string successMessage;

            if (editingItemId is int id)
            {
                var item = await dbContext.StandaloneGroceryItems
                    .FirstOrDefaultAsync(existing => existing.Id == id);
                if (item is null)
                {
                    ResetForm();
                    feedbackMessage = "That item could not be found. Please try again.";
                    isValidationError = true;
                    return;
                }

                item.Name = trimmedName;
                item.Quantity = itemQuantity.Trim();
                item.Category = itemCategory;
                successMessage = $"{item.Name} updated.";
            }
            else
            {
                dbContext.StandaloneGroceryItems.Add(new StandaloneGroceryItem
                {
                    Name = trimmedName,
                    Quantity = itemQuantity.Trim(),
                    Category = itemCategory
                });
                successMessage = $"{trimmedName} added to your list.";
            }

            await dbContext.SaveChangesAsync();
            ResetForm();

            if (await LoadItemsAsync())
            {
                feedbackMessage = successMessage;
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to save a standalone grocery item.");
            feedbackMessage = "Unable to save the grocery item. Please try again.";
            isValidationError = true;
        }
    }

    private void BeginEdit(StandaloneGroceryItem item)
    {
        editingItemId = item.Id;
        itemName = item.Name;
        itemQuantity = item.Quantity;
        itemCategory = item.Category;
        feedbackMessage = "";
    }

    private void CancelEdit()
    {
        ResetForm();
        feedbackMessage = "";
        isValidationError = false;
    }

    private void HandleEditModalKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var item = await dbContext.StandaloneGroceryItems
                .FirstOrDefaultAsync(existing => existing.Id == id);
            if (item is null)
            {
                feedbackMessage = "That item could not be found. Please try again.";
                isValidationError = true;
                return;
            }

            var itemName = item.Name;
            dbContext.StandaloneGroceryItems.Remove(item);
            await dbContext.SaveChangesAsync();

            if (editingItemId == id)
            {
                ResetForm();
            }

            if (await LoadItemsAsync())
            {
                feedbackMessage = $"{itemName} removed from your list.";
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to delete standalone grocery item {GroceryItemId}.", id);
            feedbackMessage = "Unable to delete the grocery item. Please try again.";
            isValidationError = true;
        }
    }

    private async Task TogglePurchased(int id, bool isPurchased)
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var item = await dbContext.StandaloneGroceryItems
                .FirstOrDefaultAsync(existing => existing.Id == id);
            if (item is null)
            {
                feedbackMessage = "That item could not be found. Please try again.";
                isValidationError = true;
                return;
            }

            item.IsPurchased = isPurchased;
            var successMessage = isPurchased
                ? $"{item.Name} marked as purchased."
                : $"{item.Name} marked as not purchased.";
            await dbContext.SaveChangesAsync();

            if (await LoadItemsAsync())
            {
                feedbackMessage = successMessage;
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to update purchase status for grocery item {GroceryItemId}.", id);
            feedbackMessage = "Unable to update the purchased status. Please try again.";
            isValidationError = true;
        }
    }

    private async Task ClearPurchased()
    {
        var purchasedItems = items.Where(item => item.IsPurchased).ToList();
        if (purchasedItems.Count == 0)
        {
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var persistedPurchasedItems = await dbContext.StandaloneGroceryItems
                .Where(item => item.IsPurchased)
                .ToListAsync();
            var purchasedIds = persistedPurchasedItems.Select(item => item.Id).ToArray();
            dbContext.StandaloneGroceryItems.RemoveRange(persistedPurchasedItems);
            await dbContext.SaveChangesAsync();

            if (editingItemId is int editingId && purchasedIds.Contains(editingId))
            {
                ResetForm();
            }

            if (await LoadItemsAsync())
            {
                feedbackMessage = $"{persistedPurchasedItems.Count.ToString(CultureInfo.InvariantCulture)} purchased item(s) cleared.";
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to clear purchased standalone grocery items.");
            feedbackMessage = "Unable to clear purchased items. Please try again.";
            isValidationError = true;
        }
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
    }

    private void ResetForm()
    {
        editingItemId = null;
        itemName = "";
        itemQuantity = "";
        itemCategory = Categories[0];
    }

}
