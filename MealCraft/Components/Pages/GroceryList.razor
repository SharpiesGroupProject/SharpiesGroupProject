@page "/grocery-list"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using MealCraft.Data
@using MealCraft.Models
@using Microsoft.Data.Sqlite
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MealCraftDbContext> DbContextFactory
@inject ILogger<GroceryList> Logger
@using System.Globalization
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Grocery List - MealCraft</PageTitle>

<div class="grocery-page">
    <div class="grocery-heading">
        <div>
            <p class="grocery-eyebrow">MEALCRAFT <span>/</span> SHOPPING</p>
            <h1>Grocery list</h1>
            <p class="grocery-subtitle">A little planning makes every grocery run easier.</p>
        </div>
        <div class="list-date">
            <span class="date-label">YOUR LIST</span>
            <strong>This week</strong>
        </div>
    </div>

    <section class="grocery-summary" aria-label="Grocery list summary">
        <div class="summary-card">
            <span class="summary-icon summary-icon-blue" aria-hidden="true">✓</span>
            <div><strong>@RemainingCount</strong><span>left to get</span></div>
        </div>
        <div class="summary-card">
            <span class="summary-icon summary-icon-amber" aria-hidden="true">✓</span>
            <div><strong>@PurchasedCount</strong><span>in your basket</span></div>
        </div>
        <div class="summary-card summary-card-total">
            <span class="summary-icon summary-icon-neutral" aria-hidden="true">≡</span>
            <div><strong>@items.Count</strong><span>items on your list</span></div>
        </div>
    </section>

    <section class="add-item-panel" aria-labelledby="add-item-heading">
        <div class="panel-heading">
            <div>
                <p class="section-kicker">MAKE IT YOURS</p>
                <h2 id="add-item-heading">Add an item</h2>
            </div>
            <span class="add-item-mark" aria-hidden="true">+</span>
        </div>

        <form class="item-form" @onsubmit="SaveItem" @onsubmit:preventDefault>
            <div class="form-field item-name-field">
                <label for="item-name">Item name <span aria-hidden="true">*</span></label>
                <input id="item-name" type="text" @bind="itemName" maxlength="80"
                       placeholder="e.g. Ripe avocados" autocomplete="off" />
            </div>
            <div class="form-field quantity-field">
                <label for="item-quantity">Quantity <span class="optional-label">optional</span></label>
                <input id="item-quantity" type="text" @bind="itemQuantity" maxlength="40"
                       placeholder="e.g. 3 or 500 g" />
            </div>
            <div class="form-field category-field">
                <label for="item-category">Category</label>
                <select id="item-category" @bind="itemCategory">
                    @foreach (var category in Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="primary-button" type="submit">Add to list</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <p class="form-feedback @(isValidationError ? "feedback-error" : "feedback-success")"
               role="@(isValidationError ? "alert" : "status")" aria-live="polite">@feedbackMessage</p>
        }
    </section>

    <section class="list-panel" aria-labelledby="list-heading">
        <div class="list-toolbar">
            <div>
                <p class="section-kicker">READY WHEN YOU ARE</p>
                <h2 id="list-heading">Your items <span class="item-count">@items.Count</span></h2>
            </div>
            <button type="button" class="clear-button" @onclick="ClearPurchased" disabled="@(PurchasedCount == 0)">
                Clear purchased
            </button>
        </div>

        <div class="list-filters" role="group" aria-label="Filter grocery items">
            <button type="button" class="filter-button @(selectedFilter == "all" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "all")" @onclick="@(() => SetFilter("all"))">
                All <span>@items.Count</span>
            </button>
            <button type="button" class="filter-button @(selectedFilter == "to-buy" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "to-buy")" @onclick="@(() => SetFilter("to-buy"))">
                To buy <span>@RemainingCount</span>
            </button>
            <button type="button" class="filter-button @(selectedFilter == "purchased" ? "selected" : "")"
                    aria-pressed="@(selectedFilter == "purchased")" @onclick="@(() => SetFilter("purchased"))">
                Purchased <span>@PurchasedCount</span>
            </button>
        </div>

        @if (!VisibleItems.Any())
        {
            <div class="empty-list">
                <span class="empty-list-icon" aria-hidden="true">✓</span>
                <h3>@(items.Count == 0 ? "Your list is clear" : "Nothing in this view")</h3>
                <p>@(items.Count == 0 ? "Add an item above to get your shopping started." : "Try another filter to see your grocery items.")</p>
            </div>
        }
        else
        {
            <ul class="grocery-items">
                @foreach (var item in VisibleItems)
                {
                    <li class="grocery-item @(item.IsPurchased ? "is-purchased" : "")"
                        @key="@($"{(item.IsRecipeGenerated ? "recipe" : "manual")}-{item.Id}")">
                        <label class="purchase-toggle">
                            <input type="checkbox" checked="@item.IsPurchased"
                                   aria-label="Mark @item.Name @(item.IsPurchased ? "as not purchased" : "as purchased")"
                                   @onchange="args => TogglePurchased(item, args.Value is bool isPurchased && isPurchased)" />
                            <span class="custom-checkbox" aria-hidden="true"></span>
                        </label>
                        <div class="item-copy">
                            <strong>@item.Name</strong>
                            <div class="item-details">
                                @if (!string.IsNullOrWhiteSpace(item.Quantity))
                                {
                                    <span>@item.Quantity</span>
                                }
                                <span class="category-tag">@item.Category</span>
                            </div>
                        </div>
                        <div class="item-actions">
                            @if (item.IsRecipeGenerated)
                            {
                                <button type="button" class="icon-button delete-button"
                                        aria-label="Remove @item.Name from this week's grocery list"
                                        title="Remove from this week's list" @onclick="@(() => DismissRecipeItem(item.Id))">
                                    Remove
                                </button>
                            }
                            else
                            {
                                <button type="button" class="icon-button" aria-label="Edit @item.Name"
                                        title="Edit item" @onclick="@(() => BeginEdit(item))">
                                    Edit
                                </button>
                                <button type="button" class="icon-button delete-button" aria-label="Delete @item.Name"
                                        title="Delete item" @onclick="@(() => DeleteItem(item.Id))">
                                    Delete
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        <p class="list-note">Your grocery list and purchased status are saved between visits.</p>
    </section>
</div>

@if (editingItemId is not null)
{
    <div class="edit-modal-backdrop">
        <section class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-item-heading"
                 tabindex="-1" @onkeydown="HandleEditModalKeydown">
            <div class="panel-heading edit-modal-heading">
                <div>
                    <p class="section-kicker">UPDATE YOUR LIST</p>
                    <h2 id="edit-item-heading">Edit item</h2>
                </div>
                <button class="icon-button edit-modal-close" type="button" aria-label="Close edit dialog"
                        @onclick="CancelEdit">×</button>
            </div>

            <form class="edit-item-form" @onsubmit="SaveItem" @onsubmit:preventDefault>
                <div class="form-field">
                    <label for="edit-item-name">Item name <span aria-hidden="true">*</span></label>
                    <input id="edit-item-name" type="text" @bind="itemName" maxlength="80"
                           autocomplete="off" autofocus />
                </div>
                <div class="form-field">
                    <label for="edit-item-quantity">Quantity <span class="optional-label">optional</span></label>
                    <input id="edit-item-quantity" type="text" @bind="itemQuantity" maxlength="40" />
                </div>
                <div class="form-field">
                    <label for="edit-item-category">Category</label>
                    <select id="edit-item-category" @bind="itemCategory">
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                @if (isValidationError && !string.IsNullOrEmpty(feedbackMessage))
                {
                    <p class="form-feedback feedback-error" role="alert">@feedbackMessage</p>
                }

                <div class="edit-modal-actions">
                    <button class="text-button" type="button" @onclick="CancelEdit">Cancel</button>
                    <button class="primary-button" type="submit">Save changes</button>
                </div>
            </form>
        </section>
    </div>
}

@code {
    private static readonly string[] Categories = ["Produce", "Dairy", "Bakery", "Pantry", "Meat & seafood", "Household", "Other"];
    private const string RecipeItemSourceType = "MealPlan";

    private List<GroceryListEntry> items = [];

    private string itemName = "";
    private string itemQuantity = "";
    private string itemCategory = Categories[0];
    private string selectedFilter = "all";
    private string feedbackMessage = "";
    private bool isValidationError;
    private int? editingItemId;
    private int? currentMealPlanId;
    private string? userId;

    private int RemainingCount => items.Count(item => !item.IsPurchased);
    private int PurchasedCount => items.Count(item => item.IsPurchased);

    private IEnumerable<GroceryListEntry> VisibleItems => items
        .Where(item => selectedFilter switch
        {
            "to-buy" => !item.IsPurchased,
            "purchased" => item.IsPurchased,
            _ => true
        })
        .OrderBy(item => item.IsPurchased)
        .ThenBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await SyncRecipeItemsAsync();
        await LoadItemsAsync();
    }

    private static DateOnly CurrentWeekStart
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            return today.AddDays(-(int)today.DayOfWeek);
        }
    }

    private async Task<bool> SyncRecipeItemsAsync()
    {
        currentMealPlanId = null;
        if (userId is null)
        {
            return true;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var weekStart = CurrentWeekStart;
            var rangeStart = weekStart.ToDateTime(TimeOnly.MinValue);
            var rangeEnd = weekStart.AddDays(7).ToDateTime(TimeOnly.MinValue);
            var mealPlanWeekStart = weekStart.AddDays(1).ToDateTime(TimeOnly.MinValue);

            var mealPlan = await dbContext.MealPlans
                .FirstOrDefaultAsync(plan => plan.UserId == userId && plan.WeekStartDate == mealPlanWeekStart);
            var plannedMeals = await dbContext.PlannedMeals
                .Where(meal => meal.MealPlan.UserId == userId
                    && meal.MealDate >= rangeStart && meal.MealDate < rangeEnd)
                .Include(meal => meal.Recipe)
                    .ThenInclude(recipe => recipe.Ingredients)
                        .ThenInclude(ingredient => ingredient.Product)
                .ToListAsync();

            if (mealPlan is null && plannedMeals.Count == 0)
            {
                return true;
            }

            if (mealPlan is null)
            {
                mealPlan = new MealPlan
                {
                    UserId = userId,
                    WeekStartDate = mealPlanWeekStart,
                    IsActive = true
                };
                dbContext.MealPlans.Add(mealPlan);
                await dbContext.SaveChangesAsync();
            }

            currentMealPlanId = mealPlan.Id;
            var existingItems = await dbContext.GroceryListItems
                .Include(item => item.Sources)
                .Where(item => item.MealPlanId == mealPlan.Id && item.SourceType == RecipeItemSourceType)
                .ToListAsync();
            var previousState = existingItems
                .GroupBy(item => CreateGroupKey(item.ProductId, item.Name, item.Unit))
                .ToDictionary(
                    group => group.Key,
                    group => (
                        IsPurchased: group.Any(item => item.IsPurchased),
                        IsDismissed: group.Any(item => item.IsDismissed)));
            var aggregates = new Dictionary<GroceryGroupKey, RecipeGroceryAggregate>();

            foreach (var plannedMeal in plannedMeals)
            {
                foreach (var ingredient in plannedMeal.Recipe.Ingredients)
                {
                    var key = CreateGroupKey(ingredient.ProductId, ingredient.Name, ingredient.Unit);
                    if (!aggregates.TryGetValue(key, out var aggregate))
                    {
                        aggregate = new RecipeGroceryAggregate(
                            ingredient.ProductId,
                            ingredient.Product?.Name ?? ingredient.Name.Trim(),
                            ingredient.Unit.Trim(),
                            0);
                        aggregates.Add(key, aggregate);
                    }

                    aggregate.Quantity += ingredient.Quantity;
                    aggregate.Sources.Add(new GroceryItemSource
                    {
                        PlannedMealId = plannedMeal.Id,
                        RecipeIngredientId = ingredient.Id,
                        Quantity = ingredient.Quantity,
                        Unit = ingredient.Unit
                    });
                }
            }

            dbContext.GroceryListItems.RemoveRange(existingItems);
            foreach (var (key, aggregate) in aggregates)
            {
                previousState.TryGetValue(key, out var state);
                dbContext.GroceryListItems.Add(new GroceryListItem
                {
                    MealPlanId = mealPlan.Id,
                    ProductId = aggregate.ProductId,
                    CreatedAt = DateTime.UtcNow,
                    Name = aggregate.Name,
                    Quantity = aggregate.Quantity,
                    Unit = aggregate.Unit,
                    SourceType = RecipeItemSourceType,
                    IsPurchased = state.IsPurchased,
                    IsDismissed = state.IsDismissed,
                    Sources = aggregate.Sources
                });
            }

            await dbContext.SaveChangesAsync();
            return true;
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to sync grocery items from the current week's planned recipes.");
            feedbackMessage = "Unable to update grocery items from your meal plan. Please try again.";
            isValidationError = true;
            return false;
        }
    }

    private static GroceryGroupKey CreateGroupKey(int? productId, string name, string unit) =>
        new(productId, productId is null ? name.Trim().ToUpperInvariant() : "", unit.Trim().ToUpperInvariant());

    private async Task<bool> LoadItemsAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var manualItems = await dbContext.StandaloneGroceryItems
                .AsNoTracking()
                .ToListAsync();
            var loadedItems = manualItems
                .Select(item => new GroceryListEntry(
                    item.Id,
                    false,
                    item.Name,
                    item.Quantity,
                    item.Category,
                    item.IsPurchased))
                .ToList();

            if (currentMealPlanId is int mealPlanId)
            {
                var recipeItems = await dbContext.GroceryListItems
                    .AsNoTracking()
                    .Include(item => item.Product)
                    .Where(item => item.MealPlanId == mealPlanId
                        && item.SourceType == RecipeItemSourceType
                        && !item.IsDismissed)
                    .ToListAsync();
                loadedItems.AddRange(recipeItems.Select(item => new GroceryListEntry(
                    item.Id,
                    true,
                    item.Name,
                    FormatQuantity(item.Quantity, item.Unit),
                    string.IsNullOrWhiteSpace(item.Product?.Category)
                        ? "From recipes"
                        : item.Product?.Category ?? "From recipes",
                    item.IsPurchased)));
            }

            items = loadedItems;
            return true;
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to load grocery items.");
            feedbackMessage = "Unable to load your grocery list. Please try again.";
            isValidationError = true;
            return false;
        }
    }

    private static string FormatQuantity(decimal quantity, string unit)
    {
        var amount = quantity.ToString("0.############################", CultureInfo.InvariantCulture);
        return string.IsNullOrWhiteSpace(unit) ? amount : $"{amount} {unit}";
    }

    private async Task SaveItem()
    {
        var trimmedName = itemName.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            feedbackMessage = "Enter an item name before saving.";
            isValidationError = true;
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            string successMessage;

            if (editingItemId is int id)
            {
                var item = await dbContext.StandaloneGroceryItems
                    .FirstOrDefaultAsync(existing => existing.Id == id);
                if (item is null)
                {
                    ResetForm();
                    feedbackMessage = "That item could not be found. Please try again.";
                    isValidationError = true;
                    return;
                }

                item.Name = trimmedName;
                item.Quantity = itemQuantity.Trim();
                item.Category = itemCategory;
                successMessage = $"{item.Name} updated.";
            }
            else
            {
                dbContext.StandaloneGroceryItems.Add(new StandaloneGroceryItem
                {
                    Name = trimmedName,
                    Quantity = itemQuantity.Trim(),
                    Category = itemCategory
                });
                successMessage = $"{trimmedName} added to your list.";
            }

            await dbContext.SaveChangesAsync();
            ResetForm();

            if (await LoadItemsAsync())
            {
                feedbackMessage = successMessage;
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to save a standalone grocery item.");
            feedbackMessage = "Unable to save the grocery item. Please try again.";
            isValidationError = true;
        }
    }

    private void BeginEdit(GroceryListEntry item)
    {
        if (item.IsRecipeGenerated)
        {
            return;
        }

        editingItemId = item.Id;
        itemName = item.Name;
        itemQuantity = item.Quantity;
        itemCategory = item.Category;
        feedbackMessage = "";
    }

    private void CancelEdit()
    {
        ResetForm();
        feedbackMessage = "";
        isValidationError = false;
    }

    private void HandleEditModalKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var item = await dbContext.StandaloneGroceryItems
                .FirstOrDefaultAsync(existing => existing.Id == id);
            if (item is null)
            {
                feedbackMessage = "That item could not be found. Please try again.";
                isValidationError = true;
                return;
            }

            var itemName = item.Name;
            dbContext.StandaloneGroceryItems.Remove(item);
            await dbContext.SaveChangesAsync();

            if (editingItemId == id)
            {
                ResetForm();
            }

            if (await LoadItemsAsync())
            {
                feedbackMessage = $"{itemName} removed from your list.";
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to delete standalone grocery item {GroceryItemId}.", id);
            feedbackMessage = "Unable to delete the grocery item. Please try again.";
            isValidationError = true;
        }
    }

    private async Task TogglePurchased(GroceryListEntry entry, bool isPurchased)
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            string itemName;
            if (entry.IsRecipeGenerated)
            {
                if (currentMealPlanId is not int mealPlanId)
                {
                    return;
                }

                var item = await dbContext.GroceryListItems.FirstOrDefaultAsync(existing =>
                    existing.Id == entry.Id && existing.MealPlanId == mealPlanId);
                if (item is null)
                {
                    feedbackMessage = "That item could not be found. Please try again.";
                    isValidationError = true;
                    return;
                }

                item.IsPurchased = isPurchased;
                itemName = item.Name;
            }
            else
            {
                var item = await dbContext.StandaloneGroceryItems
                    .FirstOrDefaultAsync(existing => existing.Id == entry.Id);
                if (item is null)
                {
                    feedbackMessage = "That item could not be found. Please try again.";
                    isValidationError = true;
                    return;
                }

                item.IsPurchased = isPurchased;
                itemName = item.Name;
            }

            var successMessage = isPurchased
                ? $"{itemName} marked as purchased."
                : $"{itemName} marked as not purchased.";
            await dbContext.SaveChangesAsync();

            if (await LoadItemsAsync())
            {
                feedbackMessage = successMessage;
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to update purchase status for grocery item {GroceryItemId}.", entry.Id);
            feedbackMessage = "Unable to update the purchased status. Please try again.";
            isValidationError = true;
        }
    }

    private async Task DismissRecipeItem(int id)
    {
        if (currentMealPlanId is not int mealPlanId)
        {
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var item = await dbContext.GroceryListItems.FirstOrDefaultAsync(existing =>
                existing.Id == id && existing.MealPlanId == mealPlanId
                && existing.SourceType == RecipeItemSourceType);
            if (item is null)
            {
                feedbackMessage = "That item could not be found. Please try again.";
                isValidationError = true;
                return;
            }

            item.IsDismissed = true;
            await dbContext.SaveChangesAsync();

            if (await LoadItemsAsync())
            {
                feedbackMessage = $"{item.Name} removed from this week's grocery list.";
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to dismiss recipe grocery item {GroceryItemId}.", id);
            feedbackMessage = "Unable to remove the grocery item. Please try again.";
            isValidationError = true;
        }
    }

    private async Task ClearPurchased()
    {
        var purchasedItems = items.Where(item => item.IsPurchased).ToList();
        if (purchasedItems.Count == 0)
        {
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var persistedPurchasedItems = await dbContext.StandaloneGroceryItems
                .Where(item => item.IsPurchased)
                .ToListAsync();
            var purchasedIds = persistedPurchasedItems.Select(item => item.Id).ToArray();
            dbContext.StandaloneGroceryItems.RemoveRange(persistedPurchasedItems);
            var purchasedRecipeItems = currentMealPlanId is int mealPlanId
                ? await dbContext.GroceryListItems
                    .Where(item => item.MealPlanId == mealPlanId
                        && item.SourceType == RecipeItemSourceType
                        && item.IsPurchased
                        && !item.IsDismissed)
                    .ToListAsync()
                : new List<GroceryListItem>();
            foreach (var item in purchasedRecipeItems)
            {
                item.IsDismissed = true;
            }
            await dbContext.SaveChangesAsync();

            if (editingItemId is int editingId && purchasedIds.Contains(editingId))
            {
                ResetForm();
            }

            if (await LoadItemsAsync())
            {
                var clearedCount = persistedPurchasedItems.Count + purchasedRecipeItems.Count;
                feedbackMessage = $"{clearedCount.ToString(CultureInfo.InvariantCulture)} purchased item(s) cleared.";
                isValidationError = false;
            }
        }
        catch (Exception exception) when (exception is SqliteException or DbUpdateException)
        {
            Logger.LogError(exception, "Failed to clear purchased grocery items.");
            feedbackMessage = "Unable to clear purchased items. Please try again.";
            isValidationError = true;
        }
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
    }

    private void ResetForm()
    {
        editingItemId = null;
        itemName = "";
        itemQuantity = "";
        itemCategory = Categories[0];
    }

    private readonly record struct GroceryGroupKey(int? ProductId, string Name, string Unit);

    private sealed class RecipeGroceryAggregate(
        int? productId,
        string name,
        string unit,
        decimal quantity)
    {
        public int? ProductId { get; } = productId;
        public string Name { get; } = name;
        public string Unit { get; } = unit;
        public decimal Quantity { get; set; } = quantity;
        public List<GroceryItemSource> Sources { get; } = [];
    }

    private sealed record GroceryListEntry(
        int Id,
        bool IsRecipeGenerated,
        string Name,
        string Quantity,
        string Category,
        bool IsPurchased);
}
