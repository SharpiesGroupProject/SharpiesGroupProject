@page "/meal-planner"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using MealCraft.Data
@using MealCraft.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IDbContextFactory<MealCraftDbContext> DbFactory
@inject ILogger<MealPlanner> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Meal Planner - MealCraft</PageTitle>
<h1>Weekly Meal Planner</h1>

@if (userId is null)
{
    <div class="alert alert-danger" role="alert">
        Your user account could not be determined. Meal plans cannot be saved.
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="d-flex align-items-center gap-2 mb-3">
    <button class="btn btn-outline-secondary" @onclick="GoToPreviousWeek">&laquo; Previous Week</button>
    <button class="btn btn-outline-secondary" @onclick="GoToCurrentWeek" disabled="@(weekStart == CurrentWeekStart)">This Week</button>
    <button class="btn btn-outline-secondary" @onclick="GoToNextWeek">Next Week &raquo;</button>
    <span class="ms-3 fw-semibold">@weekStart.ToString("MMM d") - @weekStart.AddDays(6).ToString("MMM d, yyyy")</span>
</div>

<table class="table table-bordered text-center align-middle">
    <thead>
        <tr>
            <th>Meal</th>
            @for (var i = 0; i < 7; i++)
            {
                var date = weekStart.AddDays(i);
                <th>@date.ToString("ddd")<br />@date.ToString("M/d")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var slot in Slots)
        {
            <tr>
                <th>@slot</th>
                @for (var i = 0; i < 7; i++)
                {
                    var date = weekStart.AddDays(i);
                    var assigned = plannedMeals.TryGetValue((date, slot), out var meal) ? meal : null;
                    var isEditing = editingCell == (date, slot);
                    <td>
                        @if (assigned is not null && !isEditing)
                        {
                            <div>@assigned.Recipe.Title</div>
                            <button class="btn btn-sm btn-outline-secondary me-1 mt-1" @onclick="() => StartEditing(date, slot)">Replace</button>
                            <button class="btn btn-sm btn-outline-danger mt-1" @onclick="() => RemoveMeal(date, slot)">Remove</button>
                        }
                        else
                        {
                            <select class="form-select form-select-sm" value="@(assigned?.RecipeId.ToString() ?? "")"
                                    @onchange="e => AssignRecipe(date, slot, e.Value?.ToString())"
                                    disabled="@(userId is null || availableRecipes.Count == 0)">
                                <option value="">-- Select recipe --</option>
                                @foreach (var r in availableRecipes)
                                {
                                    <option value="@r.Id">@r.Title</option>
                                }
                            </select>
                            @if (isEditing)
                            {
                                <button class="btn btn-sm btn-link" @onclick="() => editingCell = null">Cancel</button>
                            }
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (availableRecipes.Count == 0)
{
    <p class="text-muted">No recipes found. Add recipes in Recipe Management to assign them here.</p>
}

@code {
    private static readonly string[] Slots = { "Breakfast", "Lunch", "Dinner" };

    private string? userId;
    private List<Recipe> availableRecipes = [];
    private DateOnly weekStart = CurrentWeekStart;
    private (DateOnly Date, string Slot)? editingCell;
    private readonly Dictionary<(DateOnly Date, string Slot), PlannedMeal?> plannedMeals = new();
    private string? errorMessage;

    private static DateOnly CurrentWeekStart => StartOfWeek(DateOnly.FromDateTime(DateTime.Today));

    private static DateOnly StartOfWeek(DateOnly date) => date.AddDays(-(int)date.DayOfWeek);

    // The MealPlan.WeekStartDate anchor used elsewhere in the app (DbSeeder) is the Monday
    // of the week, independent of this page's Sunday-first display.
    private static DateTime MealPlanWeekAnchor(DateOnly date) =>
        date.AddDays(-(((int)date.DayOfWeek + 6) % 7)).ToDateTime(TimeOnly.MinValue);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using var db = DbFactory.CreateDbContext();
        if (userId is not null)
        {
            availableRecipes = await db.Recipes
                .AsNoTracking()
                .Where(recipe => recipe.UserId == userId)
                .OrderBy(recipe => recipe.Title)
                .ToListAsync();
        }

        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        plannedMeals.Clear();
        if (userId is null)
        {
            return;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var rangeStart = weekStart.ToDateTime(TimeOnly.MinValue);
            var rangeEnd = weekStart.AddDays(6).ToDateTime(TimeOnly.MinValue);

            var meals = await db.PlannedMeals
                .AsNoTracking()
                .Include(meal => meal.Recipe)
                .Where(meal => meal.MealPlan.UserId == userId
                    && meal.MealDate >= rangeStart && meal.MealDate <= rangeEnd)
                .ToListAsync();

            foreach (var meal in meals)
            {
                plannedMeals[(DateOnly.FromDateTime(meal.MealDate), meal.MealType)] = meal;
            }

            errorMessage = null;
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Failed to load planned meals for week {WeekStart}.", weekStart);
            errorMessage = "Unable to load your meal plan. Please try again.";
        }
    }

    private async Task GoToPreviousWeek()
    {
        weekStart = weekStart.AddDays(-7);
        editingCell = null;
        await LoadWeekAsync();
    }

    private async Task GoToNextWeek()
    {
        weekStart = weekStart.AddDays(7);
        editingCell = null;
        await LoadWeekAsync();
    }

    private async Task GoToCurrentWeek()
    {
        weekStart = CurrentWeekStart;
        editingCell = null;
        await LoadWeekAsync();
    }

    private void StartEditing(DateOnly date, string slot) => editingCell = (date, slot);

    private async Task AssignRecipe(DateOnly date, string slot, string? value)
    {
        editingCell = null;

        if (userId is null || !int.TryParse(value, out var recipeId))
        {
            return;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var planWeekStart = MealPlanWeekAnchor(date);

            var mealPlan = await db.MealPlans
                .FirstOrDefaultAsync(plan => plan.UserId == userId && plan.WeekStartDate == planWeekStart);
            if (mealPlan is null)
            {
                mealPlan = new MealPlan { UserId = userId, WeekStartDate = planWeekStart, IsActive = true };
                db.MealPlans.Add(mealPlan);
                await db.SaveChangesAsync();
            }

            var mealDate = date.ToDateTime(TimeOnly.MinValue);
            var existing = await db.PlannedMeals
                .FirstOrDefaultAsync(meal => meal.MealPlanId == mealPlan.Id
                    && meal.MealDate == mealDate && meal.MealType == slot);

            if (existing is not null)
            {
                existing.RecipeId = recipeId;
            }
            else
            {
                db.PlannedMeals.Add(new PlannedMeal
                {
                    MealPlanId = mealPlan.Id,
                    RecipeId = recipeId,
                    MealDate = mealDate,
                    MealType = slot
                });
            }

            await db.SaveChangesAsync();
            errorMessage = null;
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Failed to save planned meal for {MealDate} {Slot}.", date, slot);
            errorMessage = "Unable to save that meal. Please try again.";
        }

        await LoadWeekAsync();
    }

    private async Task RemoveMeal(DateOnly date, string slot)
    {
        editingCell = null;
        if (userId is null)
        {
            return;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var mealDate = date.ToDateTime(TimeOnly.MinValue);
            var existing = await db.PlannedMeals
                .FirstOrDefaultAsync(meal => meal.MealPlan.UserId == userId
                    && meal.MealDate == mealDate && meal.MealType == slot);

            if (existing is not null)
            {
                db.PlannedMeals.Remove(existing);
                await db.SaveChangesAsync();
            }

            errorMessage = null;
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Failed to remove planned meal for {MealDate} {Slot}.", date, slot);
            errorMessage = "Unable to remove that meal. Please try again.";
        }

        await LoadWeekAsync();
    }
}
