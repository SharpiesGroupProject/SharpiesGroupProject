@page "/recipes"
@using MealCraft.Data
@using MealCraft.Models
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<MealCraftDbContext> DbFactory
<PageTitle>Recipes - MealCraft</PageTitle>

<h1>Recipe Management</h1>

@if (!showForm)
{
    <button class="btn btn-primary mb-3" @onclick="OpenForm" disabled="@(userId is null)">Add Recipe</button>
}

@if (userId is null)
{
    <div class="alert alert-danger" role="alert">
        The demo user account was not found. Recipes cannot be added.
    </div>
}

@if (showForm)
{
    <EditForm Model="newRecipe" OnValidSubmit="SaveRecipeAsync" OnInvalidSubmit="HandleInvalidSubmit"
              FormName="addRecipe" class="card card-body mb-4">
        <DataAnnotationsValidator />

        <h2 class="h4">@(isEditing ? "Edit Recipe" : "New Recipe")</h2>
        <p class="form-text"><span class="text-danger" aria-hidden="true">*</span> Required</p>

        <div class="mb-3">
            <label class="form-label">Title <span class="text-danger" aria-hidden="true">*</span></label>
            <InputText class="form-control" @bind-Value="newRecipe.Title" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" rows="2" @bind-Value="newRecipe.Description" />
        </div>
        <div class="mb-3">
            <label class="form-label">Tags used by your recipes</label>
            <div class="input-group">
                <InputSelect class="form-select" @bind-Value="selectedAvailableTag">
                    <option value="">Select an existing tag</option>
                    @foreach (var tag in availableTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </InputSelect>
                <button type="button" class="btn btn-outline-primary" @onclick="AddSelectedTag"
                        disabled="@string.IsNullOrEmpty(selectedAvailableTag)">
                    Add tag
                </button>
            </div>
            @if (availableTags.Count == 0)
            {
                <div class="form-text">No tags have been used in your recipes yet.</div>
            }
            @if (selectedTagNames.Length > 0)
            {
                <div class="mt-2">
                    @foreach (var tag in selectedTagNames)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1"
                                @onclick="() => RemoveTag(tag)">
                            @tag <span aria-hidden="true">&times;</span>
                        </button>
                    }
                </div>
            }
            <div class="input-group mt-2">
                <InputText class="form-control" @bind-Value="newTagInput" placeholder="New tag name" />
                <button type="button" class="btn btn-outline-secondary" @onclick="AddNewTag">Add new tag</button>
            </div>
            <div class="form-text">New tags are saved with this recipe and then available for your other recipes.</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Prep time (min)</label>
                <InputNumber class="form-control" @bind-Value="newRecipe.PrepTimeMinutes" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Cook time (min)</label>
                <InputNumber class="form-control" @bind-Value="newRecipe.CookTimeMinutes" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Servings <span class="text-danger" aria-hidden="true">*</span></label>
                <InputNumber class="form-control" @bind-Value="newRecipe.Servings" />
            </div>
        </div>

        <h3 class="h5">Ingredients <span class="text-danger" aria-hidden="true">*</span></h3>
        <p class="form-text">Add at least one ingredient. Ingredient names are required; quantities default to 1.</p>
        <div class="card card-body mb-3">
            <label for="product-search" class="form-label">Add an existing product</label>
            <InputText id="product-search" class="form-control mb-2" @bind-Value="productSearch"
                       placeholder="Search products" />
            <InputSelect class="form-select mb-2" @bind-Value="selectedProductId">
                <option value="">Select a product</option>
                @foreach (var product in FilteredProducts)
                {
                    <option value="@product.Id">
                        @product.Name
                        @if (!string.IsNullOrWhiteSpace(product.DefaultUnit))
                        {
                            <text>(@product.DefaultUnit)</text>
                        }
                    </option>
                }
            </InputSelect>
            <div class="row g-2">
                <div class="col-md-3">
                    <input class="form-control" type="text" inputmode="decimal"
                           @bind="selectedProductQuantityInput" @bind:event="oninput" placeholder="Qty (default 1)" />
                </div>
                <div class="col-md-3">
                    <InputText class="form-control" @bind-Value="selectedProductUnit" placeholder="Unit (optional)" />
                </div>
                <div class="col-md-6">
                    <button type="button" class="btn btn-outline-primary"
                            @onclick="AddSelectedProduct" disabled="@(selectedProductId is null)">
                        Add selected product
                    </button>
                </div>
            </div>
            @if (products.Count == 0)
            {
                <p class="form-text mb-0">No products are in the catalog yet. Add a new ingredient below.</p>
            }
            else if (!FilteredProducts.Any())
            {
                <p class="form-text mb-0">No products match that search.</p>
            }
        </div>

        <h4 class="h6">New ingredients</h4>
        <p class="form-text">New ingredient names will also be added to the product catalog when you save the recipe.</p>
        @foreach (var ingredient in newRecipe.Ingredients)
        {
            <div class="row g-2 mb-2" @key="ingredient">
                <div class="col-3 col-md-2">
                    <input class="form-control" type="text" inputmode="decimal"
                           @bind="ingredientQuantityInputs[ingredient]" @bind:event="oninput" placeholder="Qty (default 1)" />
                </div>
                <div class="col-3 col-md-2">
                    <InputText class="form-control" placeholder="Unit" @bind-Value="ingredient.Unit" />
                </div>
                <div class="col-4 col-md-6">
                    <InputText class="form-control" placeholder="Name *" @bind-Value="ingredient.Name"
                               disabled="@(ingredient.ProductId is not null)" />
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveIngredient(ingredient)">Remove</button>
                </div>
            </div>
        }
        <div class="mb-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddIngredient">Add ingredient</button>
        </div>

        <div class="mb-3">
            <label class="form-label">Cooking instructions (one step per line) <span class="text-danger" aria-hidden="true">*</span></label>
            <InputTextArea class="form-control" rows="6" @bind-Value="newRecipe.Instructions" />
        </div>

        @if (GetOrderedFormErrors().Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    @foreach (var error in GetOrderedFormErrors())
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div>
            <button type="submit" class="btn btn-success me-2">@(isEditing ? "Update" : "Save")</button>
            <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancel</button>
        </div>
    </EditForm>
}

<div class="row">
    <div class="col-md-5">
        @if (recipes.Count == 0)
        {
            <p class="text-muted">No recipes found in the database.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var recipe in recipes)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action @(selectedRecipe == recipe ? "active" : "")"
                            @onclick="() => SelectRecipe(recipe)"
                            disabled="@showForm">
                        <div class="fw-bold">@recipe.Title</div>
                        <small>@string.Join(", ", recipe.Tags)</small>
                    </button>
                }
            </div>
        }
    </div>

    <div class="col-md-7">
        @if (selectedRecipe is null)
        {
            <p class="text-muted">Select a recipe to view its details.</p>
        }
        else
        {
            <h2>@selectedRecipe.Title</h2>
            <button type="button" class="btn btn-outline-primary btn-sm me-2 mb-3" @onclick="StartEditing">Edit recipe</button>
            @if (!showForm)
            {
                <button type="button" class="btn btn-outline-danger btn-sm mb-3" @onclick="ShowDeleteOptions">Delete recipe</button>
            }

            @if (showDeleteOptions)
            {
                <div class="card card-body border-danger mb-3">
                    <p class="mb-2">Delete "@selectedRecipe.Title"? Its recipe-specific ingredient rows will be removed.</p>
                    <div class="form-check mb-3">
                        <InputCheckbox id="delete-unused-products" class="form-check-input" @bind-Value="deleteUnusedProducts" />
                        <label class="form-check-label" for="delete-unused-products">
                            Also delete catalog products used only by this recipe
                        </label>
                        <div class="form-text">Products used by other recipes will be kept. Leave unchecked to keep all catalog products.</div>
                    </div>
                    @if (deleteError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@deleteError</div>
                    }
                    <div>
                        <button type="button" class="btn btn-danger me-2" @onclick="DeleteSelectedRecipeAsync">Confirm delete</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    </div>
                </div>
            }

            <p>@selectedRecipe.Description</p>
            <p>
                Prep: @selectedRecipe.PrepTimeMinutes min |
                Cook: @selectedRecipe.CookTimeMinutes min |
                Serves: @selectedRecipe.Servings
            </p>

            <h3 class="h5">Ingredients</h3>
            <ul>
                @foreach (var ingredient in selectedRecipe.Ingredients)
                {
                    <li>@ingredient.Quantity @ingredient.Unit @ingredient.Name</li>
                }
            </ul>

            <h3 class="h5">Instructions</h3>
            <ol>
                @foreach (var step in SplitSteps(selectedRecipe.Instructions))
                {
                    <li>@step</li>
                }
            </ol>
        }
    </div>
</div>

@code {
    private const string DemoUserEmail = "demo@mealcraft.local";
    private List<Recipe> recipes = [];
    private List<Product> products = [];
    private Recipe? selectedRecipe;
    private Recipe newRecipe = new();
    private readonly Dictionary<Ingredient, string> ingredientQuantityInputs = [];
    private List<string> availableTags = [];
    private string[] selectedTagNames = [];
    private string selectedAvailableTag = string.Empty;
    private string newTagInput = string.Empty;
    private string? tagError;
    private string productSearch = string.Empty;
    private string selectedProductUnit = string.Empty;
    private string selectedProductQuantityInput = "1";
    private int? selectedProductId;
    private List<string> validationErrors = [];
    private string? formError;
    private bool showForm;
    private bool isEditing;
    private bool showDeleteOptions;
    private bool deleteUnusedProducts;
    private string? deleteError;
    private string? userId;

    private IEnumerable<Product> FilteredProducts => products
        .Where(product => product.Name.Contains(productSearch, StringComparison.CurrentCultureIgnoreCase))
        .OrderBy(product => product.Name);

    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        userId = await db.Users
            .Where(user => user.Email == DemoUserEmail)
            .Select(user => user.Id)
            .SingleOrDefaultAsync();

        await LoadRecipesAsync();
        await LoadProductsAsync();
        await LoadAvailableTagsAsync();
    }

    private void HandleInvalidSubmit(EditContext editContext)
    {
        var errors = editContext.GetValidationMessages()
            .Distinct(StringComparer.Ordinal)
            .ToList();
        formError = null;

        if (newRecipe.Servings is < 1 or > 100)
        {
            errors.RemoveAll(error => error.Contains("servings", StringComparison.OrdinalIgnoreCase));
        }

        errors.AddRange(GetRecipeValidationErrors());
        validationErrors = errors.Distinct(StringComparer.Ordinal).ToList();
    }

    private void SetFormError(string message) => formError = message;

    private List<string> GetOrderedFormErrors()
    {
        var errors = validationErrors.ToList();
        if (formError is not null)
        {
            errors.Add(formError);
        }
        if (tagError is not null)
        {
            errors.Add(tagError);
        }

        return errors
            .Distinct(StringComparer.Ordinal)
            .OrderBy(GetFormErrorOrder)
            .ToList();
    }

    private static int GetFormErrorOrder(string error)
    {
        if (error.Contains("title", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }
        if (error.Contains("description", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }
        if (error.Contains("tag", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }
        if (error.Contains("prep", StringComparison.OrdinalIgnoreCase))
        {
            return 3;
        }
        if (error.Contains("cook", StringComparison.OrdinalIgnoreCase))
        {
            return 4;
        }
        if (error.Contains("servings", StringComparison.OrdinalIgnoreCase))
        {
            return 5;
        }
        if (error.Contains("ingredient", StringComparison.OrdinalIgnoreCase)
            || error.Contains("quantity", StringComparison.OrdinalIgnoreCase)
            || error.Contains("product", StringComparison.OrdinalIgnoreCase))
        {
            return 6;
        }
        if (error.Contains("instruction", StringComparison.OrdinalIgnoreCase))
        {
            return 7;
        }

        return 8;
    }

    private void ClearFormErrors()
    {
        validationErrors.Clear();
        formError = null;
        tagError = null;
    }

    private List<string> GetRecipeValidationErrors()
    {
        var errors = new List<string>();
        if (newRecipe.Servings is < 1 or > 100)
        {
            errors.Add("Servings must be between 1 and 100.");
        }

        var namedIngredients = newRecipe.Ingredients
            .Where(ingredient => !string.IsNullOrWhiteSpace(ingredient.Name))
            .ToList();
        if (namedIngredients.Count == 0)
        {
            errors.Add("Add at least one ingredient.");
        }
        else if (namedIngredients.Any(ingredient =>
                     !ingredientQuantityInputs.TryGetValue(ingredient, out var quantityInput)
                     || !TryParseQuantity(quantityInput, out _)))
        {
            errors.Add("Enter a valid quantity greater than zero for each ingredient.");
        }

        return errors;
    }

    private void OpenForm()
    {
        newRecipe = new Recipe();
        var ingredient = new Ingredient { Quantity = 1 };
        newRecipe.Ingredients.Add(ingredient);
        ingredientQuantityInputs.Clear();
        ingredientQuantityInputs[ingredient] = FormatQuantity(ingredient.Quantity);
        CancelDelete();
        isEditing = false;
        selectedTagNames = [];
        selectedAvailableTag = string.Empty;
        newTagInput = string.Empty;
        ClearFormErrors();
        productSearch = string.Empty;
        selectedProductUnit = string.Empty;
        selectedProductQuantityInput = "1";
        selectedProductId = null;
        showForm = true;
    }

    private void StartEditing()
    {
        if (selectedRecipe is null)
        {
            return;
        }

        newRecipe = new Recipe
        {
            Id = selectedRecipe.Id,
            Title = selectedRecipe.Title,
            Description = selectedRecipe.Description,
            PrepTimeMinutes = selectedRecipe.PrepTimeMinutes,
            CookTimeMinutes = selectedRecipe.CookTimeMinutes,
            Servings = selectedRecipe.Servings,
            Instructions = selectedRecipe.Instructions,
            Ingredients = selectedRecipe.Ingredients.Select(ingredient => new Ingredient
            {
                Name = ingredient.Name,
                ProductId = ingredient.ProductId,
                Quantity = ingredient.Quantity,
                Unit = ingredient.Unit,
                DisplayOrder = ingredient.DisplayOrder
            }).ToList()
        };
        ingredientQuantityInputs.Clear();
        foreach (var ingredient in newRecipe.Ingredients)
        {
            ingredientQuantityInputs[ingredient] = FormatQuantity(ingredient.Quantity);
        }
        selectedTagNames = selectedRecipe.Tags
            .Select(tag => tag.Trim())
            .Where(tag => tag.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        selectedAvailableTag = string.Empty;
        newTagInput = string.Empty;
        ClearFormErrors();
        productSearch = string.Empty;
        selectedProductUnit = string.Empty;
        selectedProductQuantityInput = "1";
        selectedProductId = null;
        isEditing = true;
        showForm = true;
        CancelDelete();
    }

    private void CloseForm()
    {
        showForm = false;
        isEditing = false;
    }

    private void SelectRecipe(Recipe recipe)
    {
        selectedRecipe = recipe;
        CancelDelete();
    }

    private void ShowDeleteOptions()
    {
        showDeleteOptions = true;
        deleteUnusedProducts = false;
        deleteError = null;
    }

    private void CancelDelete()
    {
        showDeleteOptions = false;
        deleteUnusedProducts = false;
        deleteError = null;
    }

    private void AddIngredient()
    {
        var ingredient = new Ingredient { Quantity = 1 };
        newRecipe.Ingredients.Add(ingredient);
        ingredientQuantityInputs[ingredient] = FormatQuantity(ingredient.Quantity);
    }

    private void RemoveIngredient(Ingredient ingredient)
    {
        newRecipe.Ingredients.Remove(ingredient);
        ingredientQuantityInputs.Remove(ingredient);
    }

    private void AddSelectedTag()
    {
        var tag = availableTags.FirstOrDefault(candidate =>
            string.Equals(candidate, selectedAvailableTag, StringComparison.OrdinalIgnoreCase));
        if (tag is null)
        {
            tagError = "Select a tag from your recipes before adding it.";
            return;
        }

        selectedTagNames = selectedTagNames
            .Append(tag)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        selectedAvailableTag = string.Empty;
        tagError = null;
    }

    private void AddNewTag()
    {
        var tag = newTagInput.Trim();
        if (tag.Length == 0)
        {
            tagError = "Enter a tag name.";
            return;
        }

        if (tag.Length > 50)
        {
            tagError = "Tag names must be 50 characters or fewer.";
            return;
        }

        var existingTag = availableTags.FirstOrDefault(candidate =>
            string.Equals(candidate, tag, StringComparison.OrdinalIgnoreCase));
        var canonicalTag = existingTag
            ?? selectedTagNames.FirstOrDefault(candidate =>
                string.Equals(candidate, tag, StringComparison.OrdinalIgnoreCase))
            ?? tag;

        selectedTagNames = selectedTagNames
            .Append(canonicalTag)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        newTagInput = string.Empty;
        tagError = null;
    }

    private void RemoveTag(string tag)
    {
        selectedTagNames = selectedTagNames
            .Where(candidate => !string.Equals(candidate, tag, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private void AddSelectedProduct()
    {
        var product = products.FirstOrDefault(candidate => candidate.Id == selectedProductId);
        if (product is null)
        {
            SetFormError("Select a product from the list before adding it.");
            return;
        }

        if (!TryParseQuantity(selectedProductQuantityInput, out var quantity))
        {
            SetFormError("Enter a valid quantity greater than zero.");
            return;
        }

        var ingredient = new Ingredient
        {
            Name = product.Name,
            ProductId = product.Id,
            Quantity = quantity,
            Unit = string.IsNullOrWhiteSpace(selectedProductUnit)
                ? product.DefaultUnit ?? string.Empty
                : selectedProductUnit
        };
        newRecipe.Ingredients.Add(ingredient);
        ingredientQuantityInputs[ingredient] = FormatQuantity(quantity);

        selectedProductId = null;
        selectedProductQuantityInput = "1";
        selectedProductUnit = string.Empty;
        formError = null;
    }

    private async Task SaveRecipeAsync()
    {
        ClearFormErrors();

        // Drop blank ingredient rows before validating.
        foreach (var ingredient in newRecipe.Ingredients
                     .Where(i => string.IsNullOrWhiteSpace(i.Name))
                     .ToList())
        {
            RemoveIngredient(ingredient);
        }

        validationErrors = GetRecipeValidationErrors();
        if (validationErrors.Count > 0)
        {
            return;
        }

        foreach (var ingredient in newRecipe.Ingredients)
        {
            if (!ingredientQuantityInputs.TryGetValue(ingredient, out var quantityInput)
                || !TryParseQuantity(quantityInput, out var quantity))
            {
                SetFormError("Enter a valid quantity greater than zero for each ingredient.");
                return;
            }

            ingredient.Quantity = quantity;
        }

        newRecipe.Tags = selectedTagNames
            .Select(tag => tag.Trim())
            .Where(tag => tag.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!isEditing && userId is null)
        {
            SetFormError("The demo user account was not found. The recipe could not be saved.");
            return;
        }

        var productsToAdd = new List<Product>();
        foreach (var ingredient in newRecipe.Ingredients)
        {
            var existingProduct = products.FirstOrDefault(product =>
                string.Equals(product.Name, ingredient.Name, StringComparison.OrdinalIgnoreCase));
            if (existingProduct is not null)
            {
                ingredient.ProductId = existingProduct.Id;
                continue;
            }

            var pendingProduct = productsToAdd.FirstOrDefault(product =>
                string.Equals(product.Name, ingredient.Name, StringComparison.OrdinalIgnoreCase));
            if (pendingProduct is not null)
            {
                ingredient.Product = pendingProduct;
                continue;
            }

            var newProduct = new Product
            {
                Name = ingredient.Name,
                DefaultUnit = string.IsNullOrWhiteSpace(ingredient.Unit) ? null : ingredient.Unit
            };
            productsToAdd.Add(newProduct);
            ingredient.Product = newProduct;
        }

        for (var index = 0; index < newRecipe.Ingredients.Count; index++)
        {
            newRecipe.Ingredients[index].DisplayOrder = index + 1;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            db.Products.AddRange(productsToAdd);

            Recipe recipeToSave;
            if (isEditing)
            {
                recipeToSave = await db.Recipes
                    .Include(recipe => recipe.Ingredients)
                    .Include(recipe => recipe.RecipeTags)
                    .SingleAsync(recipe => recipe.Id == newRecipe.Id && recipe.UserId == userId);

                recipeToSave.Title = newRecipe.Title;
                recipeToSave.Description = newRecipe.Description;
                recipeToSave.PrepTimeMinutes = newRecipe.PrepTimeMinutes;
                recipeToSave.CookTimeMinutes = newRecipe.CookTimeMinutes;
                recipeToSave.Servings = newRecipe.Servings;
                recipeToSave.Instructions = newRecipe.Instructions;

                db.RecipeIngredients.RemoveRange(recipeToSave.Ingredients);
                recipeToSave.Ingredients.Clear();
                recipeToSave.Ingredients.AddRange(newRecipe.Ingredients);

                var desiredTags = newRecipe.Tags.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                foreach (var existingTag in recipeToSave.RecipeTags.ToList())
                {
                    if (!desiredTags.Contains(existingTag.TagName, StringComparer.OrdinalIgnoreCase))
                    {
                        recipeToSave.RecipeTags.Remove(existingTag);
                        db.RecipeTags.Remove(existingTag);
                    }
                }

                foreach (var tag in desiredTags)
                {
                    if (!recipeToSave.RecipeTags.Any(existingTag =>
                            string.Equals(existingTag.TagName, tag, StringComparison.OrdinalIgnoreCase)))
                    {
                        recipeToSave.RecipeTags.Add(new RecipeTag { TagName = tag });
                    }
                }
            }
            else
            {
                newRecipe.UserId = userId!;
                recipeToSave = newRecipe;
                db.Recipes.Add(recipeToSave);
            }

            await db.SaveChangesAsync();

            var savedRecipeId = recipeToSave.Id;
            await LoadRecipesAsync();
            await LoadProductsAsync();
            await LoadAvailableTagsAsync();
            selectedRecipe = recipes.Single(recipe => recipe.Id == savedRecipeId);
            CloseForm();
        }
        catch (DbUpdateException)
        {
            SetFormError("The recipe could not be saved because of a database error. Please review the recipe and try again.");
        }
    }

    private async Task DeleteSelectedRecipeAsync()
    {
        if (selectedRecipe is null || showForm)
        {
            return;
        }

        var recipeId = selectedRecipe.Id;
        await using var db = DbFactory.CreateDbContext();
        if (await db.PlannedMeals.AnyAsync(meal => meal.RecipeId == recipeId))
        {
            deleteError = "This recipe is used in a meal plan and cannot be deleted until it is removed from the plan.";
            return;
        }

        var recipe = await db.Recipes
            .Include(candidate => candidate.Ingredients)
            .Include(candidate => candidate.RecipeTags)
            .SingleOrDefaultAsync(candidate => candidate.Id == recipeId && candidate.UserId == userId);
        if (recipe is null)
        {
            deleteError = "This recipe could not be found in the database. Reload the page and try again.";
            return;
        }

        try
        {
            if (deleteUnusedProducts)
            {
                var productIds = recipe.Ingredients
                    .Where(ingredient => ingredient.ProductId is not null)
                    .Select(ingredient => ingredient.ProductId!.Value)
                    .Distinct()
                    .ToList();

                if (productIds.Count > 0)
                {
                    var productIdsUsedElsewhere = await db.RecipeIngredients
                        .Where(ingredient => ingredient.RecipeId != recipeId
                            && ingredient.ProductId.HasValue
                            && productIds.Contains(ingredient.ProductId.Value))
                        .Select(ingredient => ingredient.ProductId!.Value)
                        .Distinct()
                        .ToListAsync();

                    var productsToDelete = await db.Products
                        .Where(product => productIds.Contains(product.Id)
                            && !productIdsUsedElsewhere.Contains(product.Id))
                        .ToListAsync();
                    db.Products.RemoveRange(productsToDelete);
                }
            }

            db.Recipes.Remove(recipe);
            await db.SaveChangesAsync();

            selectedRecipe = null;
            CancelDelete();
            await LoadRecipesAsync();
            await LoadProductsAsync();
        }
        catch (DbUpdateException)
        {
            deleteError = "The recipe could not be deleted because it is still referenced by other data.";
        }
    }

    private async Task LoadProductsAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        products = await db.Products
            .AsNoTracking()
            .OrderBy(product => product.Name)
            .ToListAsync();
    }

    private async Task LoadAvailableTagsAsync()
    {
        if (userId is null)
        {
            availableTags = [];
            return;
        }

        await using var db = DbFactory.CreateDbContext();
        var tagNames = await db.RecipeTags
            .AsNoTracking()
            .Where(recipeTag => recipeTag.Recipe.UserId == userId)
            .Select(recipeTag => recipeTag.TagName.Trim())
            .Distinct()
            .ToListAsync();

        availableTags = tagNames
            .Where(tag => tag.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task LoadRecipesAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        recipes = await db.Recipes
            .AsNoTracking()
            .Where(recipe => recipe.UserId == userId)
            .Include(recipe => recipe.Ingredients)
            .Include(recipe => recipe.RecipeTags)
            .OrderBy(recipe => recipe.Title)
            .ToListAsync();
    }

    private static IEnumerable<string> SplitSteps(string instructions) =>
        instructions.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string FormatQuantity(decimal quantity) =>
        (quantity == 0 ? 1 : quantity).ToString(CultureInfo.CurrentCulture);

    private static bool TryParseQuantity(string quantityInput, out decimal quantity)
    {
        if (string.IsNullOrWhiteSpace(quantityInput))
        {
            quantity = 1;
            return true;
        }

        if (!decimal.TryParse(quantityInput, NumberStyles.Number, CultureInfo.CurrentCulture, out quantity))
        {
            return false;
        }

        if (quantity == 0)
        {
            quantity = 1;
            return true;
        }

        return quantity > 0;
    }
}